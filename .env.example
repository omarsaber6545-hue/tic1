# ==========================================
# إعدادات بوت ديسكورد (Discord Bot Settings)
# ==========================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# ==========================================
# قاعدة البيانات (Database Configuration)
# ==========================================
# يدعم PostgreSQL كما طلب:
# مثال: postgresql://postgres:password@localhost:5432/arabic_discord_bot?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/arabic_discord_bot?schema=public"

# ==========================================
# إعدادات لوحة التحكم (Dashboard Configuration)
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_random_key_here"

# صلاحيات البوت الافتراضية
DEFAULT_PREFIX="/"
